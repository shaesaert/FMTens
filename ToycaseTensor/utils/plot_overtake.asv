function [] = plot_overtake(Mfactor,sysabs, indices)
%PLOT_OVERTAKE Summary of this function goes here
%   Detailed explanation goes here
% Mfactor = cell with V_{grids,Rk} for each dimension
% l = cell with for each dimension how it should be reshaped
n = size(Mfactor,1);

% do a reshape for each
for i =1:n
    Mfactor_re{i} =  reshape(Mfactor{i},[l{i},size(Mfactor{i},2)]);
end

figure
imagesc(sysAbs{1}.hx{1}, sysAbs{2}.hx{2},squeeze(Mfactor_re{1}(:,indices{1},:))*squeeze(Mfactor_re{2}(:,indices{2},:))')


end

